<RCC>
    <qresource prefix="/">
        <!-- QML -->
        <file>qml/main.qml</file>
        
        <!-- QML Screens -->
        <file>qml/screens/BaseScreen.qml</file>
        <file>qml/screens/MediaScreen.qml</file>
        <file>qml/screens/StatisticsScreen.qml</file>
        <file>qml/screens/SettingsScreen.qml</file>

        <!-- QML Components -->
        <file>qml/components/Topbar.qml</file>
        <file>qml/components/Bottombar.qml</file>
        <file>qml/components/NavButton.qml</file>
        
        <!-- QML Themes -->
        <file>qml/themes/BaseTheme.qml</file>

        <!-- Icons  -->
        <file>assets/icons/camera.svg</file>
        <file>assets/icons/car.svg</file>
        <file>assets/icons/map.svg</file>
        <file>assets/icons/settings.svg</file>
        <file>assets/icons/statistics.svg</file>

        <!-- Images  -->
        <file>assets/images/seame-logo.png</file>

    </qresource>
</RCC>
