<RCC>
    <qresource prefix="/">
        <!-- QML -->
        <file>qml/main.qml</file>
        
        <!-- QML Screens -->
        <file>qml/screens/BaseScreen.qml</file>
        <file>qml/screens/LeftScreen.qml</file>
	    <file>qml/screens/CenterScreen.qml</file>
	    <file>qml/screens/RightScreen.qml</file>
	
        <!-- QML Components -->
        <file>qml/components/MiddleGauge.qml</file>
        <file>qml/components/LeftGauge.qml</file>
        <file>qml/components/RightGauge.qml</file>
        
        <!-- QML Themes -->
        <file>qml/themes/BaseTheme.qml</file>

        <!-- Icons  -->
        <file>assets/icons/flash.svg</file>
        <file>assets/icons/flash-warning.svg</file>
        <file>assets/icons/flash-danger.svg</file>
        <file>assets/icons/danger.svg</file>
        <file>assets/icons/danger-warning.svg</file>
        <file>assets/icons/danger-danger.svg</file>
        <file>assets/icons/temperature.svg</file>
        <file>assets/icons/temperature-low.svg</file>
        <file>assets/icons/temperature-high.svg</file>
        <file>assets/icons/compass.svg</file>
        <file>assets/icons/left-arrow.png</file>
        <file>assets/icons/right-arrow.png</file>
        <file>assets/icons/left-arrow-active.png</file>
        <file>assets/icons/right-arrow-active.png</file>
        <file>assets/icons/battery.png</file>
        <file>assets/icons/battery-warning.png</file>
        <file>assets/icons/battery-danger.png</file>
    
        <!-- Images  -->
        <file>assets/images/brisa-logo.png</file>
        <file>assets/images/critical-techworks-logo.png</file>
        <file>assets/images/eclipse-fundation-logo.png</file>
        <file>assets/images/seame-logo.png</file>
        <file>assets/images/42-logo.png</file>
    </qresource>
</RCC>
